# Dépendances
node_modules/

# Environnement local (contient JWT_SECRET, SMTP, mot de passe base...) — NE JAMAIS commiter
backend/.env
.env

# Fichiers téléversés : on ignore tout SAUF les couvertures, qui doivent être
# déployées avec le site (l'offre gratuite Render n'a pas de disque persistant,
# donc un fichier uploadé en ligne serait perdu à chaque redéploiement).
backend/uploads/*
!backend/uploads/covers/
!backend/uploads/covers/**

# Logs et divers OS
*.log
.DS_Store
Thumbs.db