# ─── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Base de données PostgreSQL ───────────────────────────────
# ⚠️ Ne JAMAIS mettre de vraie URL / mot de passe ici (ce fichier est public).
# Renseigne les vraies valeurs dans backend/.env (jamais commité) ou dans
# les variables d'environnement du serveur (Render).
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@HOST_PORTAIL_NEON/neondb?sslmode=require"

# ─── JWT ──────────────────────────────────────────────────────
# Générez avec : node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_SECRET=CHANGEZ_CE_SECRET_TRES_LONG_ET_ALEATOIRE
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Email SMTP (Gmail gratuit) ────────────────────────────────
# 1) Active la validation en 2 étapes sur le compte Google.
# 2) Crée un "mot de passe d'application" (16 caractères) :
#    https://myaccount.google.com/apppasswords
# 3) Renseigne SMTP_USER (l'adresse Gmail) et SMTP_PASS (le mot de passe d'application).
# 4) Teste la configuration :  npm run email:test
REQUIRE_EMAIL_VERIFICATION=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application-16-caracteres
EMAIL_FROM_NAME=Bibliothèque de la Congrégation

# ─── Résumé IA gratuit (Google Gemini, optionnel) ────────────────────────────
# Clé gratuite : https://aistudio.google.com/apikey (aucun paiement requis)
# Sans clé, le bouton "Résumé IA" affichera un message de configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Lookup ISBN (optionnel mais recommandé) ─────────────────────────────────
# Sans clé, l'appli interroge Google Books (quota public, parfois saturé) puis
# Open Library. Avec une clé gratuite Google Books, les résultats sont garantis
# et couvrent bien les éditions françaises : https://books.google.com/apis
GOOGLE_BOOKS_API_KEY=

# ─── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Configuration bibliothèque ──────────────────────────────
LIBRARY_NAME=Bibliothèque de la Congrégation
DEFAULT_LOAN_DAYS=21
MAX_ACTIVE_LOANS=3
